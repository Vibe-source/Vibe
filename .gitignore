# Dependencies
node_modules/
.pnp/
.pnp.js

# Build outputs
dist/
build/
*.apk
*.aab
*.apks
*.jar
# Rust core build output. `Cargo.lock` IS committed (this is a binary crate
# graph shipped into the app), only the target dirs are ignored. The glob
# matters: the standalone crates under core/ each carry their own target/.
core/target/
core/**/target/

# Build info and cache
*.tsbuildinfo
tsconfig.tsbuildinfo
*.gradle
.swift-module-cache/

# Agent files
.agents/

