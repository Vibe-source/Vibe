# Sandbox gateway — placeholders only. Names frozen by docs/agent-platform-v1.md §4.
# SANDBOX_NETWORK/SANDBOX_VOLUME_PREFIX must match compose.yml's sandbox-net and
# the gateway worker's chosen volume-naming convention — confirm with them.

SANDBOX_GATEWAY_TOKEN=changeme_shared_with_agent-runtime.env
PORT=8088

CONTAINER_SOCKET=unix:///run/podman/podman.sock
SANDBOX_IMAGE=localhost/vibe-sandbox:latest
SANDBOX_NETWORK=deploy_sandbox-net
SANDBOX_EGRESS_PROXY=http://egress-proxy:3128

# Admission control. CPU binds before memory: each sandbox takes DEFAULT_CPUS,
# so keep MAX x CPUS under the box's vCPU count. See docs/vps-deployment.md §2.
SANDBOX_MAX_CONTAINERS=4
# 1024, not 512: a browsing sandbox measured 393 MiB of unreclaimable anon on a
# light page. This is a ceiling — a code agent still only uses ~145 MiB of it.
SANDBOX_DEFAULT_MEMORY_MB=1024
SANDBOX_DEFAULT_CPUS=1
SANDBOX_PIDS_LIMIT=128
SANDBOX_IDLE_TTL_SECONDS=1800
SANDBOX_VOLUME_PREFIX=vibe-sandbox-
# Browser calls wait this long for a cold Chromium start inside the sandbox (default 90000).
SANDBOX_BROWSER_TIMEOUT_MS=90000

# Agent computer (docs/agent-computer-v1.md §3.1). A live sandbox is one with a viewer;
# past COMPUTER_MAX_LIVE the gateway answers 429 computer_capacity and the caller queues.
COMPUTER_MAX_LIVE=2
COMPUTER_SESSION_MAX_SECONDS=900
COMPUTER_VIEWER_IDLE_SECONDS=60
# Clamped on use to fps<=8, width<=900, quality<=70.
COMPUTER_DEFAULT_FPS=3
COMPUTER_DEFAULT_WIDTH=720
COMPUTER_DEFAULT_QUALITY=55
