# Vibe core — placeholders only. Copy to core.env and fill in real values.
# Every var here is read somewhere in server/config/runtime.exs or the modules
# noted below; see docs/agent-platform-v1.md §4 for the frozen isolated-runtime set.

# --- Phoenix / release ---
SECRET_KEY_BASE=changeme_run_deploy_scripts_gen-secrets.sh
PHX_HOST=api.example.com
PORT=4000
PHX_CHECK_ORIGIN=https://example.com,https://api.example.com
CORS_ORIGINS=https://example.com
POOL_SIZE=20
ECTO_IPV6=false

# --- Database (through pgbouncer; migrations bypass it — see MIGRATION_DATABASE_URL) ---
DATABASE_URL=postgresql://vibe_core_app:changeme@pgbouncer:6432/vibe_core
MIGRATION_DATABASE_URL=postgresql://vibe_core_app:changeme@postgres:5432/vibe_core
DB_SSL_VERIFY=none
# DB_CACERTFILE=/etc/ssl/certs/ca-certificates.crt

# --- Cache / rate limiting (coredata additions) ---
VALKEY_URL=redis://:changeme@valkey:6379
RATE_LIMIT_BACKEND=valkey
CLUSTER_STRATEGY=

# --- Doc renderer (own container now — see deploy/doc-renderer) ---
DOC_RENDERER_URL=http://doc-renderer:5050

# --- Isolated agent runtime bridge ---
VIBE_AGENT_RUNTIME_URL=http://agent-runtime:4100
VIBE_INTERNAL_HMAC_KEY=changeme_32_bytes_min_shared_with_agent-runtime.env
VIBE_AGENT_EXECUTION_MODE=embedded
VIBE_AI_KILL_SWITCH=0

# --- Model provider keys — remove after cutover ---
# Phase 0-2: core still runs the embedded runtime, so it needs these too.
# Phase 3 removes them once every agent is isolated (docs/agent-platform-v1.md §5).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
TAVILY_API_KEY=

# --- Supabase (storage/auth still lives there; DB moved to compose postgres) ---
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=
SUPABASE_MEDIA_BUCKET=
SUPABASE_MUSIC_BUCKET=
MEDIA_CDN_BASE_URL=

# --- Cloudflare R2 (media storage backend) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# --- Lemon Squeezy (payments) ---
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=

# --- Push: FCM/Firebase (Android) ---
FCM_SERVER_KEY=
# Fallback names notifications.ex also accepts: FIREBASE_SERVER_KEY,
# FIREBASE_CLOUD_MESSAGING_SERVER_KEY — set only one.

# --- Push: APNs (iOS voip + alert) ---
APPLE_VOIP_APNS_ENV=production
APPLE_VOIP_TEAM_ID=
APPLE_VOIP_KEY_ID=
APPLE_VOIP_PRIVATE_KEY=
APPLE_VOIP_TOPIC=
APPLE_BUNDLE_ID=com.vibegram.app

# --- Security / body limits (coresec additions) ---
# 8 MB: MLS welcome posts carry a base64 ratchet tree up to ~5.5 MB.
MAX_JSON_BODY_BYTES=8000000
MAX_UPLOAD_BYTES=120000000
DB_STATEMENT_TIMEOUT_MS=30000
AUTH_TOKEN_MAX_LIFETIME_DAYS=90

# --- Observability ---
METRICS_PORT=9568
