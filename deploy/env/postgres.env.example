# Postgres bootstrap. VIBE_CORE_DB_PASSWORD/VIBE_AGENTS_DB_PASSWORD must be
# byte-for-byte identical to the same names in pgbouncer.env — deploy/scripts/
# gen-secrets.sh prints both pairs together so they can't drift.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_superuser_password
POSTGRES_DB=postgres

VIBE_CORE_DB_PASSWORD=changeme
VIBE_AGENTS_DB_PASSWORD=changeme
