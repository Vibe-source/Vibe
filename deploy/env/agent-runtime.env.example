# Vibe agent runtime — placeholders only. Copy to agent-runtime.env and fill in.
# Names frozen by docs/agent-platform-v1.md §4; a few extra ones already read
# by agent-runtime/config/runtime.exs are included too (VIBE_AGENTS_HOST etc).

# --- Phoenix / release ---
SECRET_KEY_BASE=changeme_run_deploy_scripts_gen-secrets.sh
VIBE_AGENTS_HOST=agents.example.com
PORT=4100
POOL_SIZE=10
ECTO_IPV6=false

# --- Database (through pgbouncer; migrations bypass it) ---
DATABASE_URL=postgresql://vibe_agents_app:changeme@pgbouncer:6432/vibe_agents
MIGRATION_DATABASE_URL=postgresql://vibe_agents_app:changeme@postgres:5432/vibe_agents

# --- Core bridge (vibe-internal-auth/v1 — same key on both sides) ---
VIBE_CORE_INTERNAL_URL=http://core:4000
VIBE_INTERNAL_HMAC_KEY=changeme_32_bytes_min_shared_with_core.env
VIBE_AGENTS_PUBLIC_URL=https://agents.example.com

# --- Model provider keys (the runtime's real home — core keeps a copy until phase 3) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TAVILY_API_KEY=

# --- Sandbox gateway ---
SANDBOX_GATEWAY_URL=http://sandbox-gateway:8088
SANDBOX_GATEWAY_TOKEN=changeme_shared_with_sandbox-gateway.env

# --- Hard limits (env-configurable, never raisable by a prompt) ---
VIBE_AGENTS_KILL_SWITCH=0
VIBE_AGENTS_MAX_STEPS=24
VIBE_AGENTS_MAX_RUN_SECONDS=1200
VIBE_AGENTS_MAX_RUN_TOKENS=400000
VIBE_AGENTS_MAX_TOOL_FAILURES=6
VIBE_AGENTS_MAX_HANDOFF_DEPTH=4
# Live runs at once. Excess runs QUEUE (status stays `queued`) instead of failing.
# Keep >= SANDBOX_MAX_CONTAINERS so computer-using runs are not the thing that starves.
VIBE_AGENTS_MAX_CONCURRENT_RUNS=8
# Ranch's per-listener default is 1024 and it queues past it rather than rejecting.
RANCH_MAX_CONNECTIONS=16384

# --- Observability ---
METRICS_PORT=9568
