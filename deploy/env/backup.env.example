# Backups connect straight to postgres:5432 as the superuser (simplest way to
# pg_dump both databases with one credential) — must match postgres.env.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_superuser_password

# age recipient (public key) only — backups are encrypted here, never
# decrypted here. Generate a keypair with `age-keygen`; keep the private key
# offline (password manager / hardware key), only restore.sh ever needs it.
BACKUP_AGE_PUBLIC_KEY=age1changeme...

# Dedicated R2 bucket + scoped API token (least privilege: write-only if R2
# supports it), separate from the media R2_* credentials in core.env.
BACKUP_R2_ACCOUNT_ID=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
BACKUP_R2_BUCKET=vibe-backups
