{<<"links">>,
 [{<<"GitHub">>,<<"https://github.com/whatyouhide/redix">>},
  {<<"Sponsor">>,<<"https://github.com/sponsors/whatyouhide">>}]}.
{<<"name">>,<<"redix">>}.
{<<"version">>,<<"1.8.0">>}.
{<<"description">>,<<"Fast, pipelined, resilient Redis driver for Elixir.">>}.
{<<"elixir">>,<<"~> 1.15">>}.
{<<"app">>,<<"redix">>}.
{<<"licenses">>,[<<"MIT">>]}.
{<<"requirements">>,
 [[{<<"name">>,<<"telemetry">>},
   {<<"app">>,<<"telemetry">>},
   {<<"optional">>,false},
   {<<"requirement">>,<<"~> 0.4.0 or ~> 1.0">>},
   {<<"repository">>,<<"hexpm">>}],
  [{<<"name">>,<<"castore">>},
   {<<"app">>,<<"castore">>},
   {<<"optional">>,true},
   {<<"requirement">>,<<"~> 0.1.0 or ~> 1.0">>},
   {<<"repository">>,<<"hexpm">>}],
  [{<<"name">>,<<"nimble_options">>},
   {<<"app">>,<<"nimble_options">>},
   {<<"optional">>,false},
   {<<"requirement">>,<<"~> 0.5.0 or ~> 1.0">>},
   {<<"repository">>,<<"hexpm">>}]]}.
{<<"files">>,
 [<<"lib">>,<<"lib/redix.ex">>,<<"lib/redix">>,<<"lib/redix/cluster.ex">>,
  <<"lib/redix/connector.ex">>,<<"lib/redix/format.ex">>,
  <<"lib/redix/uri.ex">>,<<"lib/redix/start_options.ex">>,
  <<"lib/redix/exceptions.ex">>,<<"lib/redix/connection.ex">>,
  <<"lib/redix/socket_owner.ex">>,<<"lib/redix/telemetry.ex">>,
  <<"lib/redix/pubsub">>,<<"lib/redix/pubsub/connection.ex">>,
  <<"lib/redix/cluster">>,<<"lib/redix/cluster/hash.ex">>,
  <<"lib/redix/cluster/command_parser.ex">>,
  <<"lib/redix/cluster/manager.ex">>,<<"lib/redix/cluster/key_resolver.ex">>,
  <<"lib/redix/protocol.ex">>,<<"lib/redix/pubsub.ex">>,<<".formatter.exs">>,
  <<"mix.exs">>,<<"README.md">>,<<"LICENSE.txt">>,<<"CHANGELOG.md">>]}.
{<<"build_tools">>,[<<"mix">>]}.
